@model DAS_Proyecto.ViewModels.ServicioViewModel

@{
    ViewData["Title"] = "Registrar Servicio";
}

<div class="max-w-2xl mx-auto mt-8 mb-10 bg-white p-6 md:p-8 rounded-xl border border-gray-200 shadow-sm">

    <div class="mb-6">
        <h2 class="text-2xl font-bold text-gray-900">
            Registrar Nuevo Servicio
        </h2>
        <p class="text-sm text-gray-500 mt-1">
            Ingresa la información del nuevo servicio.
        </p>
    </div>

    <form asp-action="Create" method="post" class="space-y-5">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-sm text-gray-600 mb-4"></div>

        <div>
            <label asp-for="NombreServicio"
                   class="block text-sm font-semibold text-gray-700 mb-2">
                Nombre del Servicio
            </label>

            <input asp-for="NombreServicio" class="form-control" />

            <span asp-validation-for="NombreServicio"
                  class="text-sm text-gray-600 mt-1 block"></span>
        </div>

        <div>
            <label asp-for="Descripcion"
                   class="block text-sm font-semibold text-gray-700 mb-2">
                Descripción
            </label>

            <textarea asp-for="Descripcion"
                      class="form-control"
                      rows="4"
                      placeholder="Describe las características del servicio..."></textarea>

            <span asp-validation-for="Descripcion"
                  class="text-sm text-gray-600 mt-1 block"></span>
        </div>

        <div>
            <label asp-for="PrecioBase"
                   class="block text-sm font-semibold text-gray-700 mb-2">
                Precio Base
            </label>

            <input asp-for="PrecioBase"
                   type="number"
                   step="0.01"
                   class="form-control" />

            <span asp-validation-for="PrecioBase"
                  class="text-sm text-gray-600 mt-1 block"></span>
        </div>

        <div class="flex flex-wrap justify-end gap-3 pt-5 border-t border-gray-200">
            <a asp-action="Index" class="btn-cancel">
                Cancelar
            </a>

            <button type="submit" class="btn-primary-orange">
                Guardar Servicio
            </button>
        </div>

    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
