@model IEnumerable<DAS_Proyecto.Models.Usuario>

@{
    ViewData["Title"] = "Gestión de usuarios";
}

<div class="max-w-6xl mx-auto">

    <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
        <div>
            <h1 class="text-2xl font-extrabold text-gray-900">Gestión de usuarios</h1>
            <p class="text-sm text-gray-500 mt-1">
                Administra las cuentas y los roles del sistema.
            </p>
        </div>

        <a asp-action="Create"
           class="inline-flex items-center rounded-lg bg-amber-500 hover:bg-amber-600 text-white font-semibold px-4 py-2 shadow-sm transition">
            + Nuevo usuario
        </a>
    </div>

    @if (TempData["MensajeExito"] is string exito)
    {
        <div class="mb-4 rounded-lg bg-green-50 border border-green-200 text-green-800 p-3">
            @exito
        </div>
    }

    @if (TempData["MensajeError"] is string error)
    {
        <div class="mb-4 rounded-lg bg-red-50 border border-red-200 text-red-800 p-3">
            @error
        </div>
    }

    <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">

        <form asp-action="Index" method="get" class="flex flex-wrap gap-3 mb-5">
            <input type="search"
                   name="busqueda"
                   value="@(ViewBag.Busqueda ?? "")"
                   placeholder="Buscar por nombre, correo o rol..."
                   class="border border-gray-300 rounded-lg px-3 py-2 min-w-[260px] flex-1 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400" />

            <button type="submit"
                    class="rounded-lg bg-gray-800 hover:bg-gray-700 text-white px-5 py-2 font-semibold transition">
                Buscar
            </button>

            <a asp-action="Index"
               class="inline-flex items-center rounded-lg border border-gray-300 hover:bg-gray-50 px-4 py-2 text-gray-700 font-semibold transition">
                Limpiar
            </a>
        </form>

        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">

                <thead class="text-xs uppercase text-gray-500 bg-gray-50 border-b border-gray-200">
                    <tr>
                        <th class="py-3 px-4">Nombre</th>
                        <th class="py-3 px-4">Correo</th>
                        <th class="py-3 px-4">Rol</th>
                        <th class="py-3 px-4 text-right">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var usuario in Model)
                        {
                            <tr class="border-b border-gray-100 last:border-0 hover:bg-gray-50 transition">

                                <td class="py-4 px-4 font-semibold text-gray-800">
                                    @usuario.Nombre
                                </td>

                                <td class="py-4 px-4 text-gray-600">
                                    @usuario.Correo
                                </td>

                                <td class="py-4 px-4">
                                    <span class="inline-flex rounded-full bg-amber-50 text-amber-700 border border-amber-200 px-3 py-1 text-xs font-semibold">
                                        @usuario.Rol
                                    </span>
                                </td>

                                <td class="py-4 px-4 text-right whitespace-nowrap">
                                    <div class="inline-flex items-center gap-2">

                                        <a asp-action="Edit"
                                           asp-route-id="@usuario.IdUsuario"
                                           class="inline-flex items-center rounded-md border border-blue-200 bg-blue-50 hover:bg-blue-100 text-blue-700 px-3 py-1.5 text-xs font-semibold transition">
                                            Editar
                                        </a>

                                        <form asp-action="Delete"
                                              asp-route-id="@usuario.IdUsuario"
                                              method="post"
                                              class="inline-flex"
                                              onsubmit="return confirm('¿Eliminar este usuario?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="inline-flex items-center rounded-md border border-red-200 bg-red-50 hover:bg-red-100 text-red-700 px-3 py-1.5 text-xs font-semibold transition">
                                                Eliminar
                                            </button>
                                        </form>

                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="py-10 text-center text-gray-500">
                                No hay usuarios que coincidan con la búsqueda.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>
